---
import "../styles/global.css";
import FooterComponent from '@components/FooterComponent';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Report Power Outage App</title>
	</head>
	<body>
		<div class="p-4 flex flex-col min-h-screen justify-center items-center">
			<div class="header">
			</div>
			<div class="content">
                <slot/>
			</div>
			<div class="footer">
				<FooterComponent client:only path={Astro.url.pathname} />
			</div>
		</div>
	</body>
</html>