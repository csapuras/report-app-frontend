---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout>
    <h1>Your report has been submitted, someone from the office will get back to you soon.</h1>
    <div class="text-center">
        <span class="text-center border-b-1 border-solid border-b-(--color-accent) my-4">
            <a href="/" class="text-center font-medium text-(--link-color) transition-colors hover:bg-transparent hover:text-(--link-color) hover:cursor-pointer">
                Submit Another Report
            </a>
        </span>
    </div>
</BaseLayout> 